---

<div class="grid-container fluid">
  <div class="grid-x section__container section__home">
    <div class="medium-12 cell nav__header">
      <h1 class="nav__title">{{ section_home_name }}</h1>
      <div class="nav__subtitle">{{ section_home_role }}</div>
      <div class="nav__links grid-x">
        {% for link in links %}
        <a href="{{ link.url }}" target="{{ link.target }}" class="small-12 medium-shrink cell nav__link">{{ link.name
          }}</a>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

<div id="projects" class="grid-container fluid">
  <div class="section__container section__projects">
    <div class="grid-x grid-padding-x">
      <div class="medium-12 cell">
        <h2 class="section__title">{{ section_projects_title }}</h2>
      </div>

      {% for item in work %}
      <div class="medium-6 large-4 cell">
        <a href="{{ item.pasta }}/" class="project__item">
          <img src="/assets/img/thumb/{{ item.pasta }}.jpg" alt="{{ item.titulo }}">
          <div class="project__title">{{ item.titulo }}</div>
        </a>
      </div>
      {% endfor %}
    </div>
  </div>
</div>

<div id="about" class="grid-container fluid">
  <div class="section__container section__about">
    <div class="grid-x grid-padding-x">
      <div class="medium-12 cell">
        <h2 class="section__title">{{ section_about_title }}</h2>
      </div>
      <div class="medium-7 cell about__content">
        {% for item in description %}
        <p class="about__description">
          {{ item }}
        </p>
        {% endfor %}
      </div>
      <div class="medium-5 cell about__image">
        <div class="about__image-container">        
          <img src="/assets/img/{{ img }}" alt="">
        </div>
      </div>
    </div>
  </div>
</div>